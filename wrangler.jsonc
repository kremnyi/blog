// The whole docker-compose.yml, minus the Raspberry Pi.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "blog",
    "main": "worker/src/index.ts",
    "compatibility_date": "2026-10-01",
    "assets": {
        "directory": "./frontend/build",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/media/*", "/health/"]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "blog",
            // `npx wrangler d1 create blog` prints this id
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "migrations"
        }
    ],
    "kv_namespaces": [
        {
            "binding": "MEDIA",
            // `npx wrangler kv namespace create MEDIA` prints this id
            "id": "00000000000000000000000000000000"
        }
    ],
    "triggers": {
        // publish scheduled posts every 5 minutes, expire subscriptions hourly
        "crons": ["*/5 * * * *", "0 * * * *"]
    },
    "vars": {
        "DEFAULT_FROM_EMAIL": "noreply@blog.local"
    },
    "observability": { "enabled": true }
}
